package pages

import "github.com/schmorrison/goshpanel/internal/ui/layouts"

// Home renders the public landing page.
templ Home() {
	@layouts.Base("GoshPanel", homeContent())
}

templ homeContent() {
	<div class="mx-auto flex min-h-full max-w-3xl flex-col px-6 py-16">
		<p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-400">Linux hosting control panel</p>
		<h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">GoshPanel</h1>
		<p class="mt-4 text-lg text-slate-300">
			Manage files, databases, domains, email, and server operations from a Go-native admin panel.
		</p>
		<div class="mt-8">
			<a href="/login" class="inline-flex rounded-xl bg-emerald-500 px-5 py-3 text-sm font-semibold text-slate-950 hover:bg-emerald-400">
				Sign in to dashboard
			</a>
		</div>
	</div>
}

// Login renders the sign-in form.
templ Login(csrfToken string, errorMessage string) {
	@layouts.Base("Sign in — GoshPanel", loginContent(csrfToken, errorMessage))
}

templ loginContent(csrfToken string, errorMessage string) {
	<div class="mx-auto flex min-h-full max-w-md flex-col justify-center px-6 py-12">
		<h1 class="text-3xl font-bold text-white">Sign in</h1>
		<p class="mt-2 text-sm text-slate-400">Use your GoshPanel administrator account.</p>
		if errorMessage != "" {
			<p class="mt-6 rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">{ errorMessage }</p>
		}
		<form method="post" action="/login" class="mt-8 space-y-4">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<div>
				<label for="username" class="mb-2 block text-sm font-medium text-slate-300">Username</label>
				<input id="username" name="username" type="text" autocomplete="username" required class="w-full rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-emerald-500 focus:outline-none"/>
			</div>
			<div>
				<label for="password" class="mb-2 block text-sm font-medium text-slate-300">Password</label>
				<input id="password" name="password" type="password" autocomplete="current-password" required class="w-full rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-emerald-500 focus:outline-none"/>
			</div>
			<button type="submit" class="w-full rounded-xl bg-emerald-500 px-4 py-3 text-sm font-semibold text-slate-950 hover:bg-emerald-400">
				Sign in
			</button>
		</form>
	</div>
}

// Dashboard renders the authenticated home view.
templ Dashboard(username string, csrfToken string) {
	@layouts.Admin("Dashboard — GoshPanel", username, csrfToken, "dashboard", dashboardContent())
}

templ dashboardContent() {
	<div class="px-6 py-8 lg:px-10">
		<header class="mb-10">
			<h1 class="text-3xl font-bold text-white">Dashboard</h1>
			<p class="mt-2 text-slate-400">Choose a module to get started. Feature pages arrive in upcoming phases.</p>
		</header>
		<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
			@moduleCard("Files", "Browse and manage server files.", "files", true)
			@moduleCard("Domains", "Manage DNS records and virtual hosts.", "domains", true)
			@moduleCard("Database", "Inspect schemas and run queries.", "database", false)
			@moduleCard("Email", "Configure mail accounts and routing.", "email", false)
			@moduleCard("Logging", "Tail application and system logs.", "logging", true)
			@moduleCard("Security", "Certificates, access, and hardening.", "security", false)
		</section>
	</div>
}

templ moduleCard(title string, description string, slug string, enabled bool) {
	<article class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5 shadow-lg shadow-black/20">
		<h2 class="text-lg font-semibold text-white">{ title }</h2>
		<p class="mt-2 text-sm leading-6 text-slate-400">{ description }</p>
		if enabled {
			<a href={ templ.URL("/" + slug) } class="mt-4 inline-flex text-sm font-semibold text-emerald-300 hover:text-emerald-200">
				Open module →
			</a>
		} else {
			<p class="mt-4 text-xs font-medium uppercase tracking-wide text-slate-500">/{ slug }/ — coming soon</p>
		}
	</article>
}
