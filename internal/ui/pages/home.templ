package pages

import "github.com/schmorrison/goshpanel/internal/ui/layouts"

// Home renders the GoshPanel landing page.
templ Home() {
	@layouts.Base("GoshPanel", homeContent())
}

templ homeContent() {
	<div class="mx-auto flex min-h-full max-w-5xl flex-col px-6 py-12">
		<header class="mb-12">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-400">Linux hosting control panel</p>
			<h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">GoshPanel</h1>
			<p class="mt-4 max-w-2xl text-lg text-slate-300">
				A Go-native control panel for files, databases, domains, email, and server operations.
			</p>
		</header>
		<section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			@moduleCard("Files", "Browse and manage server files.", "files")
			@moduleCard("Database", "Inspect schemas and run queries.", "database")
			@moduleCard("Domains", "Manage DNS records and virtual hosts.", "domains")
			@moduleCard("Email", "Configure mail accounts and routing.", "email")
			@moduleCard("Logging", "Tail application and system logs.", "logging")
			@moduleCard("Security", "Certificates, access, and hardening.", "security")
		</section>
		<footer class="mt-auto pt-12 text-sm text-slate-500">
			Phase 0 foundation — authentication and modules arrive in upcoming releases.
		</footer>
	</div>
}

templ moduleCard(title string, description string, slug string) {
	<article class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5 shadow-lg shadow-black/20">
		<h2 class="text-lg font-semibold text-white">{ title }</h2>
		<p class="mt-2 text-sm leading-6 text-slate-400">{ description }</p>
		<p class="mt-4 text-xs font-medium uppercase tracking-wide text-slate-500">/{ slug }/ — coming soon</p>
	</article>
}
